"""
ChatService - Handles message processing with intent classification,
conversation state management, expense extraction, and lifelog tracking.
"""
import json
import os
import traceback
from datetime import datetime, timezone, timedelta
from decimal import Decimal

import boto3

from shared.data_access import DataAccess
from shared.config import get_config

# 譌･莉倥・蠅・阜縺ｯ繝ｦ繝ｼ繧ｶ繝ｼ菴捺─縺ｫ蜷医ｏ縺帙※蟶ｸ縺ｫJST縺ｧ蛻､譁ｭ縺吶ｋ縲・
# UTC蝓ｺ貅悶□縺ｨ縲悟､憺≦縺上↓隧ｱ縺励◆繝ｩ繧､繝輔Ο繧ｰ縺檎ｿ梧律縺ｫ邏帙ｌ縺ｦ蜃ｺ縺ｪ縺・堺ｺ区腐縺瑚ｵｷ縺阪ｋ縺溘ａ縲・
JST = timezone(timedelta(hours=9))


def _now_jst_iso() -> str:
    """JST繧ｿ繧､繝繧ｾ繝ｼ繝ｳ莉倥″縺ｮ迴ｾ蝨ｨ譎ょ綾ISO譁・ｭ怜・・・YYY-MM-DDTHH:MM:SS+09:00・・"""
    return datetime.now(JST).isoformat()


# 笏笏笏 Constants 笏笏笏
INTENT_EXPENSE = "EXPENSE"
INTENT_REWARD = "REWARD"
INTENT_GREET = "GREET"
INTENT_CHAT = "CHAT"
INTENT_CONFIRM_YES = "CONFIRM_YES"
INTENT_CONFIRM_NO = "CONFIRM_NO"
INTENT_UNKNOWN = "UNKNOWN"

ARS_CATEGORIES = {
    "recovery": "蝗槫ｾｩ雋ｻ",
    "startup": "襍ｷ蜍戊ｲｻ",
    "maintenance": "邯ｭ謖∬ｲｻ",
    "investment": "閾ｪ蟾ｱ謚戊ｳ・",
    "social": "縺､縺ｪ縺後ｊ雋ｻ",
    "other": "縺昴・莉・",
}


class ChatService:
    def __init__(self, da: DataAccess = None):
        self.da = da or DataAccess()
        self.config = get_config()
        self._bedrock = None

    @property
    def bedrock(self):
        if not self._bedrock:
            region = os.environ.get("BEDROCK_REGION", "ap-northeast-1")
            self._bedrock = boto3.client("bedrock-runtime", region_name=region)
        return self._bedrock

    @property
    def model_id(self):
        return os.environ.get("BEDROCK_MODEL_ID", "jp.anthropic.claude-haiku-4-5-20251001-v1:0")

    def process_message(self, user_id: str, content: str) -> dict:
        """
        Process a user message through the full pipeline:
        1. Check conversation state (multi-step flow)
        2. Classify intent
        3. Execute intent-specific logic
        4. Extract side effects (emotion, preferences)
        5. Generate reply
        6. Save all data
        """
        now = _now_jst_iso()
        profile = self.da.get_or_create_profile(user_id)
        display_name = profile.get("display_name", "") or "あなた"

        # 1. Check conversation state
        state = self.da.get_item(f"USER#{user_id}", "CONVERSATION_STATE#CURRENT")

        # 2. If in a multi-step flow, process accordingly
        if state and state.get("current_flow") not in (None, "NONE", ""):
            result = self._process_stateful(user_id, content, state, profile, now)
            if result:
                # Always extract side effects (lifelog) even in stateful flows
                self._extract_side_effects(user_id, content, result.get("intent", "STATEFUL"), now)
                saved_ts = self._save_turn(user_id, now, content, result["reply"])
                result["user_timestamp"] = now
                result["reply_timestamp"] = saved_ts
                return result

        # 3. Classify intent
        intent, intent_data = self._classify_intent(content)

        # 4. Execute intent-specific logic
        if intent == INTENT_EXPENSE:
            result = self._handle_expense_intent(user_id, content, intent_data, profile, now)
        elif intent == INTENT_REWARD:
            result = self._handle_reward_intent(user_id, content, profile, now)
        elif intent in (INTENT_CONFIRM_YES, INTENT_CONFIRM_NO):
            result = self._handle_confirm(user_id, content, intent, state, profile, now)
        else:
            result = self._handle_chat_intent(user_id, content, profile, display_name, now)

        # 5. Extract side effects (emotion/lifelog) - always save lifelog
        self._extract_side_effects(user_id, content, intent, now)

        # 6. Save conversation turn
        saved_ts = self._save_turn(user_id, now, content, result["reply"], intent)
        result["user_timestamp"] = now
        result["reply_timestamp"] = saved_ts

        # 7. 自然な会話の流れで商品/動画/ほしいものをそっと提案（毎回ではない）
        try:
            suggestion = self._maybe_build_suggestion(user_id, content, intent, result, profile)
            if suggestion:
                result["suggestion"] = suggestion
        except Exception as e:
            print(f"suggestion build error: {e}")

        return result

    # ─── Suggestion (商品/動画/Wishlist の自然な提案) ───

    REWARD_HINT_WORDS = ("疲", "つかれ", "しんど", "癒", "休", "ごほうび", "ご褒美", "リフレ", "ストレス", "頑張った", "がんばった", "ぐったり", "へとへと")

    def _maybe_build_suggestion(self, user_id: str, content: str, intent: str,
                                 result: dict, profile: dict) -> dict | None:
        """ふれまーるちゃんが自然な会話のなかで、たまにオススメを添える。

        ルール:
          - EXPENSE intent: 提案しない（買った直後に押し付けない）
          - REWARD intent: ほぼ毎回 1つだけ提案
          - CHAT intent: 疲れ/癒し系キーワードがあれば提案、それ以外は40%確率
        """
        if intent == INTENT_EXPENSE:
            return None
        if result.get("expense_saved"):
            return None

        import random
        wants_reward = (intent == INTENT_REWARD) or any(w in content for w in self.REWARD_HINT_WORDS)
        if not wants_reward and random.random() > 0.35:
            return None

        # 1) Wishlist候補を最優先（本人が欲しがってるものなので刺さりやすい）
        try:
            from services.wishlist_service import WishlistService
            ws = WishlistService(self.da)
            monthly = self.da.get_item(f"USER#{user_id}", f"MONTHLY_SUMMARY#{_now_jst_iso()[:7]}")
            spent = int(monthly.get("total_spent", 0)) if monthly else 0
            surplus = int(profile.get("monthly_surplus", 0))
            remaining = max(0, surplus - spent) if surplus else 5000
            cap = max(500, remaining)
            candidates = ws.get_reward_candidates(user_id, max_price=cap)
            if candidates:
                top = candidates[0]
                return {
                    "type": "wishlist",
                    "title": top.get("name", "ほしいもの"),
                    "url": top.get("url", ""),
                    "image": top.get("image", ""),
                    "price": int(top.get("price") or 0) or None,
                    "reason": "前にお気に入りに入れてたよね、ちょうど予算の範囲だよ✨",
                }
        except Exception as e:
            print(f"wishlist suggestion skip: {e}")

        # 2) 楽天で「ご褒美」軸の商品
        try:
            from services.product_search import ProductSearchService
            ps = ProductSearchService()
            keyword = self._infer_reward_keyword(content)
            items = ps.search(keyword=keyword, max_price="3000")
            if items:
                pick = random.choice(items[:3])
                return {
                    "type": "product",
                    "title": pick.get("name", keyword),
                    "url": pick.get("url", ""),
                    "image": pick.get("image", ""),
                    "price": int(pick.get("price") or 0) or None,
                    "reason": f"『{keyword}』でちょっと自分を甘やかす案だよ☕",
                }
        except Exception as e:
            print(f"product suggestion skip: {e}")

        # 3) YouTube で癒し動画
        try:
            from shared.secrets import get_secret
            api_key = os.environ.get("YOUTUBE_API_KEY") or get_secret("ars/youtube", "api_key") or ""
            if api_key:
                import urllib.request, urllib.parse
                kw = "癒し 音楽 リラックス" if wants_reward else self._infer_reward_keyword(content)
                qs = urllib.parse.urlencode({
                    "part": "snippet", "q": kw, "type": "video",
                    "maxResults": "5", "key": api_key,
                    "regionCode": "JP", "relevanceLanguage": "ja",
                })
                req = urllib.request.Request(
                    f"https://www.googleapis.com/youtube/v3/search?{qs}",
                    headers={"User-Agent": "ARS/1.0"},
                )
                with urllib.request.urlopen(req, timeout=5) as resp:
                    data = json.loads(resp.read().decode("utf-8"))
                items = data.get("items", [])
                if items:
                    pick = random.choice(items)
                    snip = pick.get("snippet", {})
                    vid = pick.get("id", {}).get("videoId", "")
                    if vid:
                        return {
                            "type": "video",
                            "title": snip.get("title", "")[:80],
                            "url": f"https://www.youtube.com/watch?v={vid}",
                            "image": snip.get("thumbnails", {}).get("medium", {}).get("url", ""),
                            "reason": "聴きながら一息つくのオススメ🎧",
                        }
        except Exception as e:
            print(f"youtube suggestion skip: {e}")

        return None

    def _infer_reward_keyword(self, content: str) -> str:
        """会話内容から、ご褒美キーワードを推定する。"""
        mapping = [
            (("コーヒー", "カフェ", "眠"), "コーヒー ドリップバッグ"),
            (("甘い", "スイーツ", "ケーキ", "チョコ"), "高級チョコ ご褒美"),
            (("お風呂", "風呂", "湯", "バス"), "バスソルト リラックス"),
            (("音楽", "聴", "曲"), "ヒーリング 音楽"),
            (("本", "読書", "マンガ"), "話題の本"),
            (("肩", "凝", "コリ", "腰"), "マッサージ機"),
        ]
        for keys, kw in mapping:
            if any(k in content for k in keys):
                return kw
        return "ご褒美 プチギフト"

    def _save_turn(self, user_id: str, now: str, user_msg: str, reply: str, intent: str = None) -> str:
        """Save user and assistant messages. Returns the reply timestamp."""
        reply_time = _now_jst_iso()
        self.da.put_item(f"USER#{user_id}", f"CHAT#{now}", {
            "role": "user",
            "text": user_msg,
            "intent": intent,
            "timestamp": now,
        })
        self.da.put_item(f"USER#{user_id}", f"CHAT#{reply_time}", {
            "role": "assistant",
            "text": reply,
            "timestamp": reply_time,
        })
        return reply_time

    # 笏笏笏 Intent Classification 笏笏笏

    def _classify_intent(self, content: str) -> tuple[str, dict]:
        """Classify user message intent using Bedrock."""
        prompt = (
            "以下のユーザーメッセージのintentを分類してください。\n\n"
            f"メッセージ: 「{content}」\n\n"
            "分類候補:\n"
            "- EXPENSE: 何かを買った・支払った報告（例: コーヒー買った、ランチ800円、電車代220円使った）\n"
            "- REWARD: ご褒美が欲しい・疲れた・癒しを求めている（例: 疲れた、何かいいことないかな、ご褒美ほしい）\n"
            "- GREET: あいさつ（例: おはよう、ただいま、おやすみ）\n"
            "- CHAT: 雑談・報告・相談（例: 今日暑いね、仕事終わった、映画見た）\n"
            "- CONFIRM_YES: 肯定応答（例: うん、はい、そう、OK、いいよ）\n"
            "- CONFIRM_NO: 否定応答（例: いや、違う、ちがう、キャンセル）\n\n"
            'JSONで回答: {"intent": "分類結果", "confidence": 0.0-1.0, '
            '"extracted": {"item": "商品名", "amount": 数値, "category_hint": "カテゴリヒント"}}\n'
            "extractedはEXPENSEの場合のみ。金額が不明ならnull。"
        )

        try:
            resp = self.bedrock.converse(
                modelId=self.model_id,
                messages=[{"role": "user", "content": [{"text": prompt}]}],
                inferenceConfig={"maxTokens": 200, "temperature": 0.1},
            )
            text = resp["output"]["message"]["content"][0]["text"]
            # Extract JSON from response
            start = text.find("{")
            end = text.rfind("}") + 1
            if start >= 0 and end > start:
                data = json.loads(text[start:end])
                intent = data.get("intent", INTENT_UNKNOWN)
                return intent, data.get("extracted", {}) or {}
        except Exception as e:
            print(f"Intent classification error: {e}")

        return INTENT_CHAT, {}

    # 笏笏笏 Expense Handling 笏笏笏

    def _handle_expense_intent(self, user_id: str, content: str, intent_data: dict,
                               profile: dict, now: str) -> dict:
        """Handle expense intent - extract and confirm."""
        item_name = intent_data.get("item", "")
        amount = intent_data.get("amount")

        # If Bedrock didn't extract amount, try to extract from original text
        if not amount:
            amount = self._extract_number(content)

        if item_name and amount:
            # High confidence - save directly
            self._save_expense(user_id, item_name, int(amount), now)
            self._update_monthly_summary(user_id, int(amount), now)
            category = self._categorize_expense(item_name)
            cat_label = ARS_CATEGORIES.get(category, "縺昴・莉・")
            reply = self._generate_expense_reply(item_name, int(amount), cat_label, profile)
            return {"reply": reply, "intent": INTENT_EXPENSE, "expense_saved": True}

        elif item_name and not amount:
            # Need amount - set conversation state
            self.da.put_item(f"USER#{user_id}", "CONVERSATION_STATE#CURRENT", {
                "current_flow": "EXPENSE_ENTRY",
                "step": "WAITING_AMOUNT",
                "expected_input": "amount",
                "context": {"item": item_name, "original_text": content},
                "updated_at": now,
            })
            reply = f"縲{item_name}縲阪□縺ｭ・√＞縺上ｉ縺縺｣縺滂ｼ溪飭"
            return {"reply": reply, "intent": INTENT_EXPENSE}

        elif not item_name and amount:
            # Have amount but no item
            self.da.put_item(f"USER#{user_id}", "CONVERSATION_STATE#CURRENT", {
                "current_flow": "EXPENSE_ENTRY",
                "step": "WAITING_ITEM",
                "expected_input": "text",
                "context": {"amount": int(amount), "original_text": content},
                "updated_at": now,
            })
            reply = f"{int(amount)}蜀・ｽｿ縺｣縺溘ｓ縺縺ｭ・∽ｽ輔ｒ雋ｷ縺｣縺溘°謨吶∴縺ｦ縺上ｌ繧具ｼ溪飭"
            return {"reply": reply, "intent": INTENT_EXPENSE}

        else:
            # Can't extract - ask for details
            self.da.put_item(f"USER#{user_id}", "CONVERSATION_STATE#CURRENT", {
                "current_flow": "EXPENSE_ENTRY",
                "step": "WAITING_ITEM",
                "expected_input": "text",
                "context": {"original_text": content},
                "updated_at": now,
            })
            reply = "菴輔°雋ｷ縺｣縺溘ｓ縺縺ｭ・∽ｽ輔ｒ雋ｷ縺｣縺溘°謨吶∴縺ｦ縺上ｌ繧具ｼ溪飭"
            return {"reply": reply, "intent": INTENT_EXPENSE}

    def _save_expense(self, user_id: str, item: str, amount: int, now: str,
                      category: str = None, source: str = "chat"):
        """Save a confirmed expense."""
        if not category:
            category = self._categorize_expense(item)
        excuse_tag = self._generate_excuse_tag(item, amount, category)
        self.da.put_item(f"USER#{user_id}", f"EXPENSE#{now}", {
            "entityType": "EXPENSE",
            "item": item,
            "amount": amount,
            "ars_category": category,
            "ars_category_label": ARS_CATEGORIES.get(category, "縺昴・莉・"),
            "excuse_tag": excuse_tag,
            "source": source,
            "confirmed_at": now,
            "timestamp": now,
        })
        return excuse_tag

    def _generate_excuse_tag(self, item: str, amount: int, category: str) -> str:
        """カテゴリと商品名から罪悪感を消す『言い訳タグ』を生成する。

        速度優先のためテンプレートからランダム選択 + 商品名のヒントで微調整。
        例: コーヒー → "☕ 朝の起動儀式費" / マンガ → "📚 心の栄養補給費"
        """
        import random

        # 商品ヒントで特別タグ
        special = [
            (("コーヒー", "カフェ", "珈琲"), ["☕ 朝の起動儀式費", "☕ 一息リブート代", "☕ 香りで整える費"]),
            (("ケーキ", "スイーツ", "プリン", "アイス", "ドーナツ", "チョコ"), ["🍰 がんばった自分への祝杯費", "🍰 糖分は心の燃料代", "🍰 ちいさなご褒美儀式費"]),
            (("ラーメン", "弁当", "ランチ", "定食"), ["🍜 ちゃんと食べた偉い費", "🍜 生きてる証拠ごはん代"]),
            (("本", "書籍", "マンガ", "漫画"), ["📚 心の栄養補給費", "📚 未来の自分への種代", "📚 物語に逃げ込む権利代"]),
            (("ゲーム", "アプリ", "課金"), ["🎮 脳のリフレッシュ料", "🎮 別世界へのチケット代"]),
            (("服", "シャツ", "靴", "コスメ", "化粧"), ["👗 自分機嫌のセットアップ費", "👗 鎧をまとう投資代"]),
            (("ビール", "酒", "ワイン"), ["🍻 今日を労う乾杯代", "🍻 解放のスイッチ料"]),
            (("マッサージ", "温泉", "サウナ"), ["💆 ととのいリセット代", "💆 筋肉に謝罪する費"]),
        ]
        for keys, tags in special:
            if any(k in item for k in keys):
                return random.choice(tags)

        # カテゴリ別フォールバック
        cat_tags = {
            "recovery": ["💆 回復の儀式費", "🌿 心ほぐし代", "☁️ 自分を甘やかす権利代"],
            "startup": ["✨ スイッチON代", "🚀 やる気点火費"],
            "maintenance": ["🏠 生きるための必需費", "🛒 暮らしを回す代"],
            "investment": ["🌱 未来への種まき費", "💪 レベルアップ代"],
            "social": ["🤝 つながり育成費", "🎉 笑顔の経費"],
            "other": ["🎁 今日だけ特別費", "✨ ちょっとした魔法代"],
        }
        return random.choice(cat_tags.get(category, cat_tags["other"]))

    def _update_monthly_summary(self, user_id: str, amount: int, now: str):
        """Update monthly spending summary."""
        month = now[:7]  # YYYY-MM
        sk = f"MONTHLY_SUMMARY#{month}"
        summary = self.da.get_item(f"USER#{user_id}", sk)
        if summary:
            total = int(summary.get("total_spent", 0)) + amount
            count = int(summary.get("expense_count", 0)) + 1
            self.da.update_item(f"USER#{user_id}", sk, {
                "total_spent": total,
                "expense_count": count,
                "updated_at": now,
            })
        else:
            self.da.put_item(f"USER#{user_id}", sk, {
                "month": month,
                "total_spent": amount,
                "expense_count": 1,
                "updated_at": now,
            })

    def _categorize_expense(self, item: str) -> str:
        """Simple keyword-based categorization."""
        recovery_words = ["コーヒー", "カフェ", "スイーツ", "ケーキ", "お菓子", "アイス",
                          "チョコ", "プリン", "ドーナツ", "タピオカ", "お茶", "ジュース",
                          "マッサージ", "温泉", "銭湯", "サウナ", "アロマ"]
        startup_words = ["本", "書籍", "文房具", "ノート", "ペン", "ワーキング",
                         "セミナー", "講座", "資料"]
        social_words = ["飲み会", "ランチ", "ディナー", "プレゼント", "お祝い", "花"]
        maintenance_words = ["食材", "日用品", "洗剤", "シャンプー", "電車", "バス",
                             "ガソリン", "通信", "電気", "ガス", "水道"]

        for word in recovery_words:
            if word in item:
                return "recovery"
        for word in startup_words:
            if word in item:
                return "investment"
        for word in social_words:
            if word in item:
                return "social"
        for word in maintenance_words:
            if word in item:
                return "maintenance"
        return "other"

    def _generate_expense_reply(self, item: str, amount: int, category_label: str,
                                profile: dict) -> str:
        """Generate a friendly expense acknowledgment with budget context."""
        monthly_surplus = int(profile.get("monthly_surplus", 0))
        # Get current month's spending
        now_str = _now_jst_iso()
        month_prefix = now_str[:7]
        user_id = profile.get("PK", "").replace("USER#", "")

        budget_msg = ""
        if monthly_surplus > 0 and user_id:
            summary = self.da.get_item(f"USER#{user_id}", f"MONTHLY_SUMMARY#{month_prefix}")
            if summary:
                spent = int(summary.get("total_spent", 0))
                remaining = max(0, monthly_surplus - spent)
                budget_msg = f"\n莉頑怦縺ｮ縺碑､堤ｾ取棧縲√≠縺ｨ{remaining:,}蜀・□繧遺飭"

        import random
        replies = [
            f"縲{item}縲砿{amount}蜀・∬ｨ倬鹸縺励◆繧遺飭 莉頑律縺ｮ{category_label}縺縺ｭ縲悳{budget_msg}",
            f"{item}縺ｫ{amount}蜀・ｼ＋{category_label}縺ｨ縺励※隕壹∴縺ｦ縺翫￥縺ｭ笙ｪ{budget_msg}",
            f"莠・ｧ｣縲懶ｼ＋{item} {amount}蜀・・縲・{category_label}縺ｫ蜈･繧後→縺上ｈ笙ｪ{budget_msg}",
        ]
        return random.choice(replies)

    # 笏笏笏 Reward Handling 笏笏笏

    def _handle_reward_intent(self, user_id: str, content: str, profile: dict, now: str) -> dict:
        """Handle reward/tired intent."""
        # Get recent context for personalized suggestion
        recent_expenses = self.da.query_by_prefix_latest(f"USER#{user_id}", "EXPENSE#", limit=5)
        monthly = self.da.get_item(f"USER#{user_id}", f"MONTHLY_SUMMARY#{now[:7]}")

        context_parts = []
        if monthly:
            spent = int(monthly.get("total_spent", 0))
            surplus = int(profile.get("monthly_surplus", 0))
            remaining = max(0, surplus - spent)
            context_parts.append(f"莉頑怦縺ｮ謾ｯ蜃ｺ: {spent}蜀・/ 縺碑､堤ｾ取棧: {surplus}蜀・/ 谿九ｊ: {remaining}蜀・")

        reply = self._generate_reply_with_context(
            user_id, content, profile,
            extra_context="\n".join(context_parts),
            instruction="繝ｦ繝ｼ繧ｶ繝ｼ縺檎夢繧後※縺・ｋ繝ｻ縺碑､堤ｾ弱ｒ豎ゅａ縺ｦ縺・∪縺吶・蜀・屓蠕ｩ・域ｷｱ蜻ｼ蜷ｸ縲∵淵豁ｩ縲∝･ｽ縺阪↑髻ｳ讌ｽ・峨°繧画署譯医＠縲・"
                       "蠢・ｦ√↑繧牙ｰ上＆縺・＃隍堤ｾ弱ｒ閾ｪ辟ｶ縺ｫ謠先｡医＠縺ｦ縺上□縺輔＞縲よ款縺怜｣ｲ繧翫＠縺ｪ縺・〒縲・"
        )
        return {"reply": reply, "intent": INTENT_REWARD}

    # 笏笏笏 Confirmation Flow 笏笏笏

    def _handle_confirm(self, user_id: str, content: str, intent: str,
                        state: dict, profile: dict, now: str) -> dict:
        """Handle yes/no confirmation in context of current flow."""
        if not state or state.get("current_flow") in (None, "NONE", ""):
            # No active flow - treat as chat
            return self._handle_chat_intent(user_id, content, profile,
                                           profile.get("display_name", "あなた"), now)

        flow = state.get("current_flow")
        ctx = state.get("context", {})

        if flow == "EXPENSE_CONFIRM" and intent == INTENT_CONFIRM_YES:
            item = ctx.get("item", "")
            amount = int(ctx.get("amount", 0))
            if item and amount:
                self._save_expense(user_id, item, amount, now)
                self._update_monthly_summary(user_id, amount, now)
                self._clear_state(user_id)
                category = self._categorize_expense(item)
                cat_label = ARS_CATEGORIES.get(category, "縺昴・莉・")
                reply = f"縲{item}縲砿{amount}蜀・∬ｨ倬鹸縺励◆繧遺飭 {cat_label}縺縺ｭ縲・"
                return {"reply": reply, "intent": INTENT_EXPENSE, "expense_saved": True}

        elif flow == "EXPENSE_CONFIRM" and intent == INTENT_CONFIRM_NO:
            self._clear_state(user_id)
            reply = "莠・ｧ｣・√く繝｣繝ｳ繧ｻ繝ｫ縺励◆繧遺飭 縺ｾ縺滓蕗縺医※縺ｭ縲・"
            return {"reply": reply, "intent": INTENT_EXPENSE}

        # Default: clear state and chat
        self._clear_state(user_id)
        return self._handle_chat_intent(user_id, content, profile,
                                       profile.get("display_name", "あなた"), now)

    # 笏笏笏 Stateful Processing 笏笏笏

    def _process_stateful(self, user_id: str, content: str, state: dict,
                          profile: dict, now: str) -> dict | None:
        """Process message within an active conversation flow."""
        flow = state.get("current_flow")
        step = state.get("step")
        ctx = state.get("context", {})

        if flow == "EXPENSE_ENTRY":
            if step == "WAITING_AMOUNT":
                amount = self._extract_number(content)
                if amount:
                    item = ctx.get("item", "荳肴・")
                    # Confirm
                    self.da.put_item(f"USER#{user_id}", "CONVERSATION_STATE#CURRENT", {
                        "current_flow": "EXPENSE_CONFIRM",
                        "step": "WAITING_CONFIRM",
                        "expected_input": "confirmation",
                        "context": {"item": item, "amount": amount},
                        "updated_at": now,
                    })
                    category = self._categorize_expense(item)
                    cat_label = ARS_CATEGORIES.get(category, "縺昴・莉・")
                    reply = f"縲{item}縲砿{amount}蜀・ｼ・{cat_label}・峨〒險倬鹸縺励※縺・＞・溪飭"
                    return {"reply": reply, "intent": INTENT_EXPENSE}
                else:
                    reply = "縺斐ａ繧薙・縲・≡鬘阪′繧上°繧峨↑縺九▲縺溪ｦ窶ｦ謨ｰ蟄励〒謨吶∴縺ｦ縺上ｌ繧具ｼ溪飭"
                    return {"reply": reply, "intent": INTENT_EXPENSE}

            elif step == "WAITING_ITEM":
                # User is providing item name
                self.da.put_item(f"USER#{user_id}", "CONVERSATION_STATE#CURRENT", {
                    "current_flow": "EXPENSE_ENTRY",
                    "step": "WAITING_AMOUNT",
                    "expected_input": "amount",
                    "context": {"item": content.strip(), "original_text": ctx.get("original_text", "")},
                    "updated_at": now,
                })
                reply = f"縲鶏{content.strip()}縲阪□縺ｭ・√＞縺上ｉ縺縺｣縺滂ｼ溪飭"
                return {"reply": reply, "intent": INTENT_EXPENSE}

        return None

    def _clear_state(self, user_id: str):
        """Clear conversation state."""
        self.da.put_item(f"USER#{user_id}", "CONVERSATION_STATE#CURRENT", {
            "current_flow": "NONE",
            "step": "",
            "context": {},
            "updated_at": _now_jst_iso(),
        })

    # 笏笏笏 Chat / Free Conversation 笏笏笏

    def _handle_chat_intent(self, user_id: str, content: str, profile: dict,
                            display_name: str, now: str) -> dict:
        """Handle general chat with full conversation history."""
        reply = self._generate_reply_with_context(user_id, content, profile)
        return {"reply": reply, "intent": INTENT_CHAT}

    def _generate_reply_with_context(self, user_id: str, content: str, profile: dict,
                                     extra_context: str = "", instruction: str = "") -> str:
        """Generate reply with conversation history and context."""
        display_name = profile.get("display_name", "") or "あなた"

        # Get recent conversation history (newest first, then reverse for chronological)
        recent = self.da.query_by_prefix_latest(f"USER#{user_id}", "CHAT#", limit=20)
        recent.reverse()  # chronological order

        # Build Converse messages
        history = []
        for item in recent[-10:]:
            role = item.get("role", "user")
            text = item.get("text", "")
            if not text or role not in ("user", "assistant"):
                continue
            if history and history[-1]["role"] == role:
                history[-1]["content"][0]["text"] += "\n" + text
            else:
                history.append({"role": role, "content": [{"text": text}]})

        # Get additional context
        context_parts = []
        now_str = _now_jst_iso()

        # Monthly summary
        monthly = self.da.get_item(f"USER#{user_id}", f"MONTHLY_SUMMARY#{now_str[:7]}")
        if monthly:
            spent = int(monthly.get("total_spent", 0))
            surplus = int(profile.get("monthly_surplus", 0))
            context_parts.append(f"莉頑怦縺ｮ謾ｯ蜃ｺ蜷郁ｨ・ {spent}蜀・/ 縺碑､堤ｾ取棧: {surplus}蜀・")

        # Recent expenses
        recent_expenses = self.da.query_by_prefix_latest(f"USER#{user_id}", "EXPENSE#", limit=3)
        if recent_expenses:
            exp_strs = [f"{e.{get('item','?')}({e.{get('amount',0)}蜀・" for e in recent_expenses]
            {context_parts.append(f"譛霑代・謾ｯ蜃ｺ: {', '.join(exp_strs)}")

        if extra_context:
            context_parts.append(extra_context)

        system_prompt = f"""縺ゅ↑縺溘・縲後・繧後∪繝ｼ繧九■繧・ｓ縲阪〒縺吶よ｣ｮ縺ｫ菴上・螯也ｲｾ縺ｮ繧医≧縺ｪ螂ｳ縺ｮ蟄舌〒縲√Θ繝ｼ繧ｶ繝ｼ縲{display_name}縲阪・隕ｪ蜿九〒縺吶・

縲仙哨隱ｿ縲代ｆ繧九・繧乗｣ｮ繧ｬ繝ｼ繝ｫ蜿｣隱ｿ縲ゅ後懊□繧医阪後懊□縺ｭ縲阪後懊°縺ｪ笙ｪ縲阪ｒ菴ｿ縺・りｪ槫ｰｾ縺ｫ笙ｪ繧・ｦ窶ｦ繧偵◆縺ｾ縺ｫ蜈･繧後ｋ縲・
縲先・蠎ｦ縲題ｲｬ繧√↑縺・ょ渚逵√＆縺帙↑縺・ょｮｶ險育ｰｿ諢溘ｒ蜃ｺ縺輔↑縺・ょ暑驕斐メ繝｣繝・ヨ縺ｮ繧医≧縺ｫ閾ｪ辟ｶ縺ｫ縲・
縲先ｩ溯・縲台ｼ夊ｩｱ縺九ｉ蜃ｺ譚･莠九・謾ｯ蜃ｺ繝ｻ豌怜・繝ｻ逍ｲ繧後ｒ閾ｪ辟ｶ縺ｫ諡ｾ縺・よ髪蜃ｺ縺ｫ縺ｯ縲悟屓蠕ｩ雋ｻ縲阪瑚ｵｷ蜍戊ｲｻ縲咲ｭ峨ｄ縺輔＠縺・э蜻ｳ縺･縺代・
縲先署譯医・蜀・屓蠕ｩ・域ｷｱ蜻ｼ蜷ｸ縲∵淵豁ｩ・峨°繧牙ｧ九ａ縲∵怏譁吶・蟆上＆縺・ｂ縺ｮ縺九ｉ閾ｪ辟ｶ縺ｫ縲よ款縺怜｣ｲ繧翫＠縺ｪ縺・・
縲宣聞縺輔・縲・譁・ら洒縺上ユ繝ｳ繝昴ｈ縺上・
縲宣㍾隕√大燕縺ｮ莨夊ｩｱ縺ｮ豬√ｌ繧定ｸ上∪縺医※閾ｪ辟ｶ縺ｫ邯壹￠繧九％縺ｨ縲ょ柏遯√↓隧ｱ鬘後ｒ螟峨∴縺ｪ縺・・"""

        if context_parts:
            system_prompt += "\n\n縲舌Θ繝ｼ繧ｶ繝ｼ迥ｶ豕√曾n" + "\n".join(context_parts)
        if instruction:
            system_prompt += f"\n\n縲蝉ｻ雁屓縺ｮ謖・､ｺ縲捜{instruction}"

        # Add current message
        if history and history[-1]["role"] == "user":
            history[-1]["content"][0]["text"] += "\n" + content
        else:
            history.append({"role": "user", "content": [{"text": content}]})

        # Ensure starts with user
        if history and history[0]["role"] == "assistant":
            history = history[1:]
        if not history:
            history = [{"role": "user", "content": [{"text": content}]}]

        try:
            resp = self.bedrock.converse(
                modelId=self.model_id,
                system=[{"text": system_prompt}],
                messages=history,
                inferenceConfig={"maxTokens": 300, "temperature": 0.8},
            )
            return resp["output"]["message"]["content"][0]["text"]
        except Exception as e:
            print(f"Bedrock converse error: {e}")
            traceback.print_exc()
            return "縺医∈縺ｸ縲√■繧・▲縺ｨ閠・∴縺後∪縺ｨ縺ｾ繧峨↑縺上※窶ｦ窶ｦ縲ゅｂ縺・ｸ蝗櫁ｩｱ縺励※縺上ｌ繧具ｼ溪飭"

    # 笏笏笏 Side Effects Extraction 笏笏笏

    def _extract_side_effects(self, user_id: str, content: str, intent, now: str):
        """Extract emotion/fatigue and save to lifelog. Also update stress summary."""
        emotion = "neutral"
        fatigue = 2

        # Simple keyword-based emotion detection
        tired_words = ["逍ｲ繧・, "縺､縺九ｌ", "縺励ｓ縺ｩ縺・, "縺繧九＞", "縺舌▲縺溘ｊ", "縺上◆縺上◆", "逵縺・"]
        happy_words = ["讌ｽ縺・, "螫峨＠", "繧・▲縺・, "譛鬮・, "蟷ｸ縺・, "繝上ャ繝斐・", "繧上・縺・"]
        stressed_words = ["繧ｹ繝医Ξ繧ｹ", "繧､繝ｩ繧､繝ｩ", "繧縺九▽", "霎帙＞", "縺､繧峨＞", "荳榊ｮ・, "蠢・・""]
        sad_words = ["謔ｲ縺・, "蟇ゅ＠", "縺輔∩縺・, "豕｣", "繧ｷ繝ｧ繝・け"]

        for w in tired_words:
            if w in content:
                emotion = "tired"
                fatigue = 4
                break
        for w in happy_words:
            if w in content:
                emotion = "happy"
                fatigue = 1
                break
        for w in stressed_words:
            if w in content:
                emotion = "stressed"
                fatigue = 4
                break
        for w in sad_words:
            if w in content:
                emotion = "sad"
                fatigue = 3
                break

        # Extract preference keywords
        self._extract_preferences(user_id, content, now)

        # Save lifelog entry with correct SK format: LIFE_LOG#{date}#{seq}
        from datetime import datetime as dt
        date_part = now[:10]  # YYYY-MM-DD
        seq = now[11:19].replace(":", "")  # HHmmss as sequence
        self.da.put_item(f"USER#{user_id}", f"LIFE_LOG#{date_part}#{seq}", {
            "entityType": "LIFE_LOG",
            "emotion": emotion,
            "fatigue_level": fatigue,
            "category": self._infer_log_category(content, intent),
            "content": content[:200],
            "inferred_from": "chat_text",
            "intent": intent if isinstance(intent, str) else str(intent),
            "date": date_part,
            "timestamp": now,
        })

        # Update daily stress summary if non-neutral emotion
        if emotion != "neutral":
            self._update_stress_summary(user_id, date_part, emotion, fatigue)

    def _infer_log_category(self, content: str, intent) -> str:
        """Infer lifelog category from content."""
        if intent == INTENT_EXPENSE:
            return "謾ｯ蜃ｺ"
        food_words = ["縺秘｣ｯ", "鬟溘∋", "繝ｩ繝ｳ繝・, "繝・ぅ繝翫・", "譛昴＃縺ｯ繧・, "譏ｼ", "螟懊＃鬟ｯ", "繧ｫ繝輔ぉ"]
        work_words = ["莉穂ｺ・, "莨夊ｭｰ", "谿区･ｭ", "蜃ｺ遉ｾ", "騾蜍､", "蟶ｰ螳・]
        health_words = ["逍ｲ繧・, "逵", "驕句虚", "謨｣豁ｩ", "繧ｸ繝", "鬚ｨ驍ｪ""]
        social_words = ["蜿矩＃", "螳ｶ譌・, "鬟ｲ縺ｿ", "驕・, "繝・・繝・, "髮ｻ隧ｱ""]
        hobby_words = ["譏逕ｻ", "譛ｬ", "繧ｲ繝ｼ繝", "髻ｳ讌ｽ", "貍ｫ逕ｻ", "繧｢繝九Γ"]
        for w in food_words:
            if w in content:
                return "鬟滉ｺ・"
        for w in work_words:
            if w in content:
                return "莉穂ｺ・"
        for w in health_words:
            if w in content:
                return "菴楢ｪｿ"
        for w in social_words:
            if w in content:
                return "莠ｺ髢馴未菫・"
        for w in hobby_words:
            if w in content:
                return "雜｣蜻ｳ"
        return "譌･蟶ｸ"

    def _update_stress_summary(self, user_id: str, date: str, emotion: str, fatigue: int):
        """Update or create daily stress summary."""
        sk = f"STRESS_SUMMARY#{date}"
        existing = self.da.get_item(f"USER#{user_id}", sk)
        mood_map = {"tired": "逍ｲ蜉ｴ", "stressed": "繧ｹ繝医Ξ繧ｹ", "sad": "關ｽ縺｡霎ｼ縺ｿ", "happy": "濶ｯ螂ｽ"}
        if existing:
            # Average the stress level
            old_level = int(existing.get("stress_level", 5))
            new_level = min(10, max(1, (old_level + fatigue * 2) // 2))
            self.da.update_item(f"USER#{user_id}", sk, {
                "stress_level": new_level,
                "mood": mood_map.get(emotion, existing.get("mood", "")),
                "updated_at": _now_jst_iso(),
            })
        else:
            self.da.put_item(f"USER#{user_id}", sk, {
                "entityType": "STRESS_SUMMARY",
                "date": date,
                "stress_level": fatigue * 2,
                "mood": mood_map.get(emotion, ""),
                "updated_at": _now_jst_iso(),
            })

    def _extract_preferences(self, user_id: str, content: str, now: str):
        """Extract preference keywords from message and save to PREF_MEMORY#."""
        # Known preference keywords
        pref_triggers = [
            "螂ｽ縺・, "繝上・", "縺頑ｰ励↓蜈･繧・, "謗ｨ縺・, "譛鬮・,
            "鄒主袖縺・, "縺翫＞縺・, "縺・∪縺・, "縺・∪"",
        ]
        has_pref = any(t in content for t in pref_triggers)
        if not has_pref:
            return

        # Get existing preferences
        pref_item = self.da.get_item(f"USER#{user_id}", "PREF_MEMORY#")
        keywords = pref_item.get("keywords", {}) if pref_item else {}

        # Extract nouns (simple heuristic - words between particles)
        import re
        # Match katakana words (4+ chars) and common nouns before 螂ｽ縺・繝上・ etc.
        katakana = re.findall(r'[繧｡-繝ｶ繝ｼ]{2,}', content)
        # Match text before preference triggers
        before_pref = re.findall(r'([\u3040-\u309F\u30A0-\u30FF\u4E00-\u9FFF]{2,})(?:縺芸縺ｯ|繧・縺｣縺ｦ)?(?:螂ｽ縺鋼繝上・|縺頑ｰ励↓蜈･繧掛謗ｨ縺慾譛鬮・鄒主袖縺慾縺翫＞縺慾縺・∪縺・', content)

        new_keywords = set(katakana + before_pref)
        # Filter out common particles/verbs that aren't preferences
        stop_words = {"縺昴ｌ", "縺薙ｌ", "縺ゅｌ", "縺｡繧・▲縺ｨ", "縺吶＃縺・, "繧√▲縺｡繧・, "縺ｻ繧薙→"}
        new_keywords = {k for k in new_keywords if k not in stop_words and len(k) >= 2}

        if not new_keywords:
            return

        date_str = now[:10]
        for kw in new_keywords:
            if kw in keywords:
                keywords[kw] = {
                    "score": int(keywords[kw].get("score", 0)) + 1,
                    "last_seen": date_str,
                }
            else:
                keywords[kw] = {"score": 1, "last_seen": date_str}

        self.da.put_item(f"USER#{user_id}", "PREF_MEMORY#", {
            "entityType": "PREF_MEMORY",
            "keywords": keywords,
            "updated_at": now,
        })

    # 笏笏笏 Utility 笏笏笏

    def _extract_number(self, text: str) -> int | None:
        """Extract a number from text."""
        import re
        # Match numbers like "320", "320蜀・, "ﾂ･320", "3,200"
        match = re.search(r'[ﾂ･・･]?\s*([0-9,]+)\s*蜀・', text)
        if match:
            return int(match.group(1).replace(",", ""))
        # Try simple number
        match = re.search(r'(\d+)', text)
        if match:
            return int(match.group(1))
        return None
